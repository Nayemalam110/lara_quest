# ------------------------------------------------------------------------------
# LaraQuest Supabase Environment Configuration
# ------------------------------------------------------------------------------
# When you create your Supabase project (https://supabase.com):
# 1. Copy this file to `.env`
# 2. Fill in your project URL and public anon key from Project Settings > API
#
# If these variables are not provided, LaraQuest will automatically run in
# local Mock/Demo mode with full persistence in your browser's localStorage!
# ------------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
